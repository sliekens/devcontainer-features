{
    "id": "tea",
    "name": "Gitea CLI (tea)",
    "version": "1.1.1",
    "documentationURL": "https://gitea.com/gitea/tea",
    "description": "Installs the Gitea CLI (`tea`) from Gitea releases and enables shell completion via bash_completion.d and zsh site-functions.",
    "mounts": [
    {
            "type": "bind",
            "source": "${localEnv:HOME}/.config/tea/",
            "target": "/var/lib/tea-cli"
    }
    ],
    "onCreateCommand": "/usr/local/share/tea/on_create.sh",
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version to install. Use \"latest\", \"0.12.0\", or \"v0.12.0\"."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
