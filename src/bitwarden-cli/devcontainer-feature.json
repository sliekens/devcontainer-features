{
    "id": "bitwarden-cli",
    "name": "Bitwarden CLI",
    "version": "1.1.1",
    "description": "Installs the official Bitwarden CLI (`bw`) binary from Bitwarden release assets.",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/bitwarden-cli/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "keywords": [
        "bitwarden",
        "cli",
        "password manager"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version to install. Use \"latest\" or a release version like \"2026.2.0\" or \"v2026.2.0\"."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.config/Bitwarden CLI/",
            "target": "/home/vscode/.config/Bitwarden CLI"
        }
    ],
    "onCreateCommand": "/usr/local/share/bitwarden-cli/on_create.sh"
}
