{
    "id": "claude",
    "name": "Claude Code",
    "version": "1.2.3",
    "description": "Installs `claude` (Claude Code) via the upstream native installer and persists shared state across devcontainers.",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/claude/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "keywords": [
        "anthropic",
        "claude",
        "ai",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "stable",
            "description": "Version/channel to install. Use `stable`, `latest`, or a specific version like `2.1.58`."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.claude/",
            "target": "/var/lib/claude-container/data"
        },
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.claude.json",
            "target": "/var/lib/claude-container/claude.json"
        }
    ],
    "onCreateCommand": "/usr/local/share/claude/on_create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "Anthropic.claude-code"
            ]
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/sliekens/devcontainer-features/rename-user"
    ]
}
