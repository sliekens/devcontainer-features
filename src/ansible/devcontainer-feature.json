{
    "id": "ansible",
    "name": "Ansible",
    "version": "1.0.0",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/ansible/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "description": "Installs `ansible` and associated CLI tools using pipx",
    "dependsOn": {
        "ghcr.io/devcontainers/features/python:1": {}
    },
    "options": {
        "collections": {
            "type": "string",
            "default": "",
            "description": "Comma or whitespace-separated Ansible Galaxy collections to install."
        },
        "roles": {
            "type": "string",
            "default": "",
            "description": "Comma or whitespace-separated Ansible Galaxy roles to install."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
