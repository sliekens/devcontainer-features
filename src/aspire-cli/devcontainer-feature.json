{
    "id": "aspire-cli",
    "name": "Aspire CLI",
    "version": "1.3.2",
    "documentationURL": "https://aspire.dev/docs/",
    "description": "Installs the .NET Aspire CLI (`aspire`)",
    "options": {
        "quality": {
            "type": "string",
            "enum": [
                "release",
                "staging",
                "dev"
            ],
            "default": "release",
            "description": "Quality to download."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.aspire/",
            "target": "/var/lib/aspire-cli"
        }
    ],
    "onCreateCommand": "/usr/local/share/aspire-cli/on_create.sh",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "microsoft-aspire.aspire-vscode"
            ]
        }
    },
    "containerEnv": {
        "ASPIRE_ENABLE_CONTAINER_TUNNEL": "true",
        "ASPIRE_CLI_TELEMETRY_OPTOUT": "1"
    }
}