{
    "id": "bitwarden-secrets-manager",
    "name": "Bitwarden Secrets Manager CLI",
    "version": "1.1.2",
    "description": "Installs the Bitwarden Secrets Manager CLI (`bws`) binary from Bitwarden release assets.",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/bitwarden-secrets-manager/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "keywords": [
        "bitwarden",
        "bws",
        "secrets",
        "secrets-manager",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version to install. Use \"latest\" or a release version like \"2.0.0\", \"v2.0.0\", or \"bws-v2.0.0\"."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.config/bws/",
            "target": "/var/lib/bitwarden-secrets-manager"
        }
    ],
    "onCreateCommand": "/usr/local/share/bitwarden-secrets-manager/on_create.sh",
    "customizations": {
        "sliekens": {
            "initializeCommand": "mkdir -p \"$HOME/.config/bws\""
        }
    }
}
