{
    "id": "copilot",
    "name": "GitHub Copilot",
    "version": "1.1.1",
    "description": "Installs the GitHub `copilot` CLI from official release assets and persists shared `~/.copilot` state across devcontainers.",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/copilot/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "keywords": [
        "copilot",
        "github",
        "ai",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version to install. Use \"latest\" for the most recent stable release, or specify a version like \"1.0.3\"."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.copilot/",
            "target": "/var/lib/copilot"
        }
    ],
    "onCreateCommand": "/usr/local/share/copilot/on_create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot-chat"
            ]
        }
    }
}
