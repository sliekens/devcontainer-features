{
    "id": "mistral-vibe",
    "name": "Mistral Vibe",
    "version": "1.1.2",
    "description": "Installs Mistral Vibe CLI coding agent using Python virtual environment and persists shared state across devcontainers.",
    "documentationURL": "https://github.com/sliekens/devcontainer-features/blob/main/src/mistral-vibe/README.md",
    "licenseURL": "https://github.com/sliekens/devcontainer-features/blob/main/LICENSE",
    "keywords": [
        "mistral",
        "vibe",
        "ai",
        "cli",
        "coding",
        "agent",
        "python"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version to install. Uses pip's version resolution."
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.vibe/",
            "target": "/var/lib/vibe"
        }
    ],
    "onCreateCommand": "/usr/local/share/vibe/on_create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "nmallet.vscode-mistral-vibe"
            ]
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
