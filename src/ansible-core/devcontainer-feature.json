{
    "id": "ansible-core",
    "name": "Ansible Core",
    "version": "1.0.0",
    "documentationURL": "https://docs.ansible.com/projects/ansible-core/devel/",
    "description": "Installs ansible-core via pipx",
    "dependsOn": {
        "ghcr.io/devcontainers/features/python:1": {}
    },
    "options": {
        "collections": {
            "type": "string",
            "default": "",
            "description": "Comma or whitespace-separated Ansible Galaxy collections to install."
        },
        "roles": {
            "type": "string",
            "default": "",
            "description": "Comma or whitespace-separated Ansible Galaxy roles to install."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}